# ── Supabase (Tahap B) ──────────────────────────────────────────────
# Copy this file to `.env.local` and fill in values from your Supabase
# project (local Supabase CLI or cloud project).
#
# SECURITY (A-05): SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY.
#   - Never prefix it with NEXT_PUBLIC_.
#   - Never expose it to the browser.
#   - Used only for single-user onboarding (K-04) and admin operations.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Single-user bootstrap (K-04) ─────────────────────────────────────
# Used once by `npm run bootstrap` to create the single V1 user via the
# Auth admin API (server-side, service-role key). Not committed to git.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
